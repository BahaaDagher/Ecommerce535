@model IEnumerable<Product>
<div class="container">
    <div class="row mb-3 align-items-center my-3">
        <div class="col-md-6">
            <h2 class="display-6">All Products</h2>
        </div>
        <div class="col-md-6 text-md-end text-start mt-2 mt-md-0">
            <a href="/Admin/Products/Create" class="btn btn-success">Create</a>
        </div>
    </div>
    <section class="py-3 filter-bar">
    <div class="container">
        <div class="row" style="background-color: rgba(var(--bs-light-rgb), var(--bs-bg-opacity)) !important;">
            <div class="col-12">
                <form>
                    <div class="row">
                        <!-- Product Name -->
                        <div class="col-md-3">
                            <input type="text" class="form-control" placeholder="Product Name" name="ProductName" >
                        </div>

                        <!-- Price Range -->
                        <div class="col-md-2">
                            <input type="number" class="form-control" placeholder="Min Price" name="MinPrice">
                        </div>
                        <div class="col-md-2">
                            <input type="number" class="form-control" placeholder="Max Price" name="MaxPrice">
                        </div>

                        <!-- Category -->
                        <div class="col-md-2">
                            <select class="form-control" name="CategoryId">
                                <option>--Select Category--</option>
                                @foreach (var item in ViewBag.Categories)
                                {
                                    <option value="@item.Id"> @item.Name</option> 
                                }
                            </select>
                        </div>
                        <!-- Brand -->
                        <div class="col-md-2">
                            <select class="form-control" name="BrandId">
                                <option>--Select Brand--</option>
                                @foreach (var item in ViewBag.Brands)
                                {
                                    <option value="@item.Id"> @item.Name</option>
                                }
                            </select>
                        </div>
                        <!-- Hot Product Checkbox -->
                        <div class="col-md-1">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" name="IsLowQuanity" value="true">
                                <label class="form-check-label">IsLowQuanity</label>
                            </div>
                        </div>
                            
                        <!-- Submit Button -->
                    </div>

                    <div class="row mt-3">
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-dark w-100">Filter</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

    <div class="row">
        <div class="col-12">

            <table class="table table-hover">
                <thead>
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Name</th>
                        <th scope="col">Price</th>
                        <th scope="col">Discount</th>
                        <th scope="col">Quantity</th>
                        <th scope="col">Category name</th>
                        <th scope="col">Brand Name</th>
                        <th scope="col">Status</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <th scope="row">@item.Id</th>
                            <td>@item.Name</td>
                            <td>@item.Price</td>
                            <td>@item.Discount</td>
                            @if (@item.Quantity < 40)
                            {
                                <td class="text-danger">@item.Quantity</td>
                            }
                            else
                            {
                                <td>@item.Quantity</td>
                            }
                            <td>@item.Category.Name</td>
                            <td>@item.Brand.Name</td>
                            <td>
                                @if (item.Status)
                                {
                                    <span class="badge text-bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge text-bg-danger">
                                        in Active
                                    </span>
                                }
                            </td>
                            <td>
                                <a href="/Admin/Products/update/@item.Id" type="button" class="btn btn-warning">update</a>
                                <a href="/Admin/Products/delete/@item.Id"
                                   class="btn btn-danger btn-delete">
                                    Delete
                                </a>
                            </td>

                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>
    <nav aria-label="Page navigation example" class="d-flex justify-content-center align-items-center">
        <ul class="pagination">
            <li class="page-item">
                <a class="page-link" href="#" aria-label="Previous">
                    <span aria-hidden="true">&laquo;</span>
                </a>
            </li>
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item"><a class="page-link" 
                    href="/Admin/Products/Index?page=@i">
                    @i
                    </a>
                </li>
            }
            <li class="page-item">
                <a class="page-link" href="#" aria-label="Next">
                    <span aria-hidden="true">&raquo;</span>
                </a>
            </li>
        </ul>
    </nav>
</div>

<script>

    document.querySelectorAll('.btn-delete').forEach(button => {
        button.addEventListener('click', function (event) {
            event.preventDefault();

            const deleteUrl = this.href;

            Swal.fire({
                title: "Are you sure?",
                text: "You won't be able to revert this!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Yes, delete it!"
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = deleteUrl;
                }
            });
        });
    });
</script>